{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"src/main/index.ts",
		"src/preload/index.ts",
		"src/eyas-interface/app/index.html",
		"src/eyas-interface/app/recording-layer.html",
		"src/eyas-interface/app/src/main.ts",
		"src/eyas-interface/app/src/recording-layer.entry.ts",
		"src/eyas-interface/app/src/env.d.ts",
		"src/types/electron.d.ts",
		"src/scripts/get-config.ts",
		"src/scripts/event-bridge.ts",
		"src/scripts/recorder.ts",
		"src/types/@cypress/unique-selector.d.ts",
		"tests/e2e/**/*.spec.mjs",
		"tests/e2e/eyas-utils.mjs",
		"tests/unit/**/*.test.ts",
		"tests/electron/**/*.test.ts",
		".eyas.config.js",
		"demo/assets/components.js",
		"demo/assets/demo.js",
		"demo/demo/recording/popup.js"
	],
	"project": ["**/*.{ts,vue,mjs,js,sass,scss}"],
	"ignoreBinaries": [
		"ditto",
		"signtool",
		"pkgutil",
		"spctl",
		"productsign"
	],
	"ignoreDependencies": [
		"vue-tsc"
	],
	"paths": {
		"@/*": ["src/eyas-interface/app/src/*"],
		"@core/*": ["src/eyas-core/*"],
		"@scripts/*": ["src/scripts/*"],
		"@registry/*": ["src/types/*"],
		"@assets/*": ["src/eyas-interface/app/src/assets/*"],
		"@interface/*": ["src/eyas-interface/app/src/*"]
	}
}
